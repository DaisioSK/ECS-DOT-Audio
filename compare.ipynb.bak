      " ...\n",
      " [-10.351  -9.735 -10.825 ... -38.099 -37.938 -38.352]\n",
      " [-14.262 -14.41  -14.846 ... -37.654 -37.513 -38.015]\n",
      " [-19.98  -19.173 -21.921 ... -42.587 -42.521 -42.551]]\n",
